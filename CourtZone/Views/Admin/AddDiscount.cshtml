@model HappyHourDiscount
<h1>Add Happy Hour Discount</h1>
<form method="post" class="col-md-7">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="CourtId" class="form-label"></label><select asp-for="CourtId" asp-items="ViewBag.Courts" class="form-select"></select></div>
    <div class="mb-3"><label asp-for="DayOfWeek" class="form-label"></label><select asp-for="DayOfWeek" asp-items="Html.GetEnumSelectList<DayOfWeek>()" class="form-select"></select></div>
    <div class="mb-3"><label asp-for="StartTimeText" class="form-label"></label><input asp-for="StartTimeText" type="time" class="form-control" /></div>
    <div class="mb-3"><label asp-for="EndTimeText" class="form-label"></label><input asp-for="EndTimeText" type="time" class="form-control" /></div>
    <div class="mb-3"><label asp-for="DiscountPercentage" class="form-label"></label><input asp-for="DiscountPercentage" class="form-control" /></div>
    <div class="form-check mb-3">
    <input asp-for="IsActive" type="checkbox" class="form-check-input" />
    <label asp-for="IsActive" class="form-check-label">
        Active
    </label>
</div>
    <button class="btn btn-success">Save Discount</button>
</form>
