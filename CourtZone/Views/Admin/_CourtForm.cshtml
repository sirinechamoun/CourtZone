@model Court
<form method="post" class="col-md-7">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Sport" class="form-label"></label><select asp-for="Sport" asp-items="Html.GetEnumSelectList<SportType>()" class="form-select"></select></div>
    <div class="mb-3"><label asp-for="PricePerHour" class="form-label"></label><input asp-for="PricePerHour" class="form-control" /></div>
    <div class="mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /></div>
    <div class="mb-3"><label asp-for="ImageUrl" class="form-label"></label><input asp-for="ImageUrl" class="form-control" placeholder="/images/your-stadium.jpg or online image URL" /></div>
    <div class="form-check mb-3"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    <button class="btn btn-success">Save</button>
    <div class="mb-3">
    <label asp-for="Area" class="form-label"></label>
    <input asp-for="Area" class="form-control" placeholder="Beirut, Batroun, Jounieh..." />
</div>

<div class="mb-3">
    <label asp-for="City" class="form-label"></label>
    <input asp-for="City" class="form-control" placeholder="Beirut" />
</div>

<div class="mb-3">
    <label asp-for="DistanceFromBeirutKm" class="form-label">Distance from Beirut KM</label>
    <input asp-for="DistanceFromBeirutKm" type="number" step="0.1" class="form-control" />
</div>
</form>
